<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 is a compile-check target so shared code can be validated on hosts
         without the mobile workloads (e.g. Linux CI); it produces no runnable app. -->
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
    <RootNamespace>OWCE</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>

    <ApplicationTitle>OWCE</ApplicationTitle>

    <!-- Override with -p:ApplicationId=... when building for your own Apple Developer team. -->
    <ApplicationId Condition="'$(ApplicationId)' == ''">com.owcommunity.owce</ApplicationId>

    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">3.0.0</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" BaseSize="255,440" Color="#E6E6E6" />

    <MauiFont Include="Resources\Fonts\*.ttf" />

    <MauiImage Include="Resources\Images\burger_menu.png" BaseSize="40,40" />
    <MauiImage Include="Resources\Images\expander_dark.png" BaseSize="15,15" />
    <MauiImage Include="Resources\Images\expander_light.png" BaseSize="15,15" />
    <MauiImage Include="Resources\Images\hamburger.png" BaseSize="14,15" />
    <MauiImage Include="Resources\Images\icon_share.png" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\menu_cancel.png" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\menu_leaderboards.png" BaseSize="20,20" />
    <MauiImage Include="Resources\Images\menu_myrides.png" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\menu_onewheels.png" BaseSize="20,20" />
    <MauiImage Include="Resources\Images\menu_settings.png" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\settings_disconnect.png" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\settings_info.png" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\settings_start_recording.png" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\settings_stop_recording.png" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\splash_image.png" BaseSize="255,440" />
    <MauiImage Include="Resources\Images\swipe_delete.png" BaseSize="24,24" />
    <MauiImage Include="Resources\Images\swipe_rename.png" BaseSize="24,24" />

    <EmbeddedResource Include="Resources\SampleRideData\*.bin" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
    <PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Mopups" Version="1.3.4" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.151.2" />
    <PackageReference Include="Refractored.MvvmHelpers" Version="1.6.2" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <!-- Overrides the vulnerable SQLitePCLRaw 2.1.2 pulled in by sqlite-net-pcl (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
    <PackageReference Include="Google.Protobuf" Version="3.25.3" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

</Project>
